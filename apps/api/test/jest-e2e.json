{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "setupFiles": ["<rootDir>/test/setup-env.ts"],
  "globalSetup": "<rootDir>/test/global-setup.ts",
  "maxWorkers": 2,
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/**/*.spec.ts",
    "!src/**/migrations/**",
    "!src/main.ts",
    "!src/seed.ts",
    "!src/database/data-source.ts"
  ],
  "coverageThreshold": {
    "global": {
      "lines": 95,
      "statements": 95,
      "functions": 93,
      "branches": 85
    }
  }
}
