NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://hospital_chat:hospital_chat@localhost:5432/hospital_chat
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:3000
# Saltos de proxy de confianza: 0 en local, 1 detrás de App Service o Front Door
TRUST_PROXY=0

# Generar con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
JWT_TTL_SECONDS=1800

LOGIN_RATE_LIMIT_PER_MINUTE=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Solo los usa `npm run seed` para crear el administrador inicial
ADMIN_EMAIL=admin@hospital.local
ADMIN_PASSWORD=cambia-esta-contrasena
